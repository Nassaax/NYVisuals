{
  "name": "studio-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node logo/build.mjs && node site/build.mjs",
    "logo": "node logo/build.mjs",
    "site": "node site/build.mjs",
    "test": "node site/test.mjs",
    "documents": "node documents/build.mjs",
    "kit:exemple": "node kit/modele/build.mjs --config kit/exemple/client.json --out kit/exemple/dist",
    "kit:test": "node kit/modele/test.mjs --dist kit/exemple/dist --out kit/exemple/captures"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "axe-core": "^4.14.1",
    "marked": "^12.0.2",
    "opentype.js": "^1.3.4"
  }
}
